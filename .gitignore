# Default deny: keep only the source needed to write, build and deploy the blog.
# Review this allowlist before adding a new kind of public asset or build file.
*

!/.gitignore
!/.node-version
!/CNAME
!/_config.yml
!/_config.local.yml
!/package.json
!/package-lock.json

!/.github/
!/.github/workflows/
!/.github/workflows/pages.yml

!/scaffolds/
!/scaffolds/post.md
!/examples/
!/examples/new-post.md.example
!/scripts/
!/scripts/journal.js
!/tools/
!/tools/preflight.cjs
!/tools/check.mjs

!/source/
!/source/_posts/
!/source/_posts/*.md
!/source/assets/
!/source/assets/**/
!/source/assets/**/*.png
!/source/assets/**/*.jpg
!/source/assets/**/*.jpeg
!/source/assets/**/*.webp
!/source/assets/**/*.avif
!/source/assets/**/*.gif
!/source/assets/**/*.svg

!/themes/
!/themes/z3vok/
!/themes/z3vok/layout/
!/themes/z3vok/layout/*.ejs
!/themes/z3vok/source/
!/themes/z3vok/source/css/
!/themes/z3vok/source/css/*.css
!/themes/z3vok/source/js/
!/themes/z3vok/source/js/*.js

# Deny these even inside an allowed directory. Never force-add private files.
.DS_Store
._*
.env
.env.*
*.pem
*.key
*.p12
*.pfx
*.log
*.bak
*.orig
*.swp
*.swo
*~
node_modules/
public/
db.json
.cache/
.hexo/
.deploy_git/
.idea/
.vscode/
.agents/
.codex/
AGENTS.md
CLAUDE.md
editorial/
design/
designs/
mockups/
screenshots/
reports/
tmp/
temp/
private/
drafts/
originals/
backups/
release/
source/_drafts/

# Keep writing instructions in the local backup, outside the published repository.
README*
readme*

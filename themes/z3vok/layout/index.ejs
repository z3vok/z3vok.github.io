<% const featured=journal_featured().slice(0,6);const posts=journal_posts(); %>
<section class="home-intro wrap"><div><h1>Security notes</h1><p>Code auditing, vulnerability analysis, network forensics and AI systems.</p></div><a class="home-identity" href="/about/" aria-label="About z3vok and the Emergence artwork"><img src="/assets/emergence.png" width="96" height="96" alt="Emergence: an abstract ink ring dissolving into pixels" decoding="async"></a></section>
<section class="selected wrap" id="selected"><div class="section-heading"><h2>Selected writing</h2><a href="/writing/">All <%= posts.length %> articles →</a></div><div class="home-posts"><% featured.forEach(post=>{ %><a class="home-post" href="<%= post.path.startsWith('/') ? post.path : '/'+post.path %>"><time datetime="<%= post.date.format('YYYY-MM-DD') %>"><%= post.date.format('YYYY-MM-DD') %></time><div><h3><%= post.title %></h3><p><%= post.summary %></p><span class="post-topic"><%= post.topic %> · <%= post.lang==='en'?'English':'Chinese' %><% if(post.content_status) { %> · <%= post.content_status %><% } %></span></div></a><% }); %></div><a class="browse-all" href="/writing/">Browse all writing →</a></section>

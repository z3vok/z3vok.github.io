<% const posts=journal_posts(); const cats=journal_categories(); %>
<section class="page-intro wrap"><h1>Writing</h1><p>Security notes, source reviews and lab write-ups. Historical articles retain their original dates.</p></section>
<section class="archive-wrap wrap"><div class="archive-controls"><div class="filter-tabs" aria-label="Filter by topic"><button class="filter active" data-filter="all" aria-pressed="true">All <span><%= posts.length %></span></button><% cats.forEach(cat=>{ %><button class="filter" data-filter="<%= cat %>" aria-pressed="false"><%= cat %></button><% }); %></div><div class="archive-options"><label class="language-filter">Language <select id="archive-language"><option value="all">All languages</option><option value="en">English</option><option value="zh-CN">Chinese</option></select></label><label class="archive-search"><span aria-hidden="true">⌕</span><input type="search" id="archive-search" placeholder="Title or keyword" aria-label="Filter articles by title or keyword"></label></div></div><div class="archive-status"><span>Newest first</span><span id="archive-count" aria-live="polite"><%= posts.length %> articles</span></div><div class="archive-list"><% posts.forEach(post=>{ %><a class="archive-row" href="<%= post.path.startsWith('/') ? post.path : '/'+post.path %>" data-topic="<%= post.topic %>" data-lang="<%= post.lang %>" data-search="<%= [post.title,post.title_zh,post.original_title,post.summary,post.summary_zh,post.topic].join(' ').toLowerCase() %>"><time datetime="<%= post.date.format('YYYY-MM-DD') %>"><%= date_label(post.date) %></time><div><h2><%= post.title %></h2><p><%= post.summary %></p><span class="language-tag"><%= post.lang==='en'?'English':'Chinese' %><% if(post.content_status) { %> · <%= post.content_status %><% } %></span></div><span class="row-topic"><%= post.topic %></span><span class="row-arrow" aria-hidden="true">↗</span></a><% }); %></div><div class="empty-state" hidden><span>∅</span><h2>No matching articles.</h2><p>Try another keyword or browse all writing.</p><button id="reset-filters">Clear filters</button></div></section>

<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#f3f1eb"><meta name="description" content="<%= page.summary || config.description %>">
  <title><%= page.section === 'home' ? 'z3vok — Security notes' : page.title + ' · z3vok' %></title>
  <meta property="og:title" content="<%= page.title %> · z3vok"><meta property="og:description" content="<%= page.summary || config.description %>"><meta property="og:type" content="<%= page.layout === 'post' ? 'article' : 'website' %>">
  <% if(journal_public_origin() && page.path!=='404.html') { %><link rel="canonical" href="<%= journal_canonical(page) %>"><meta property="og:url" content="<%= journal_canonical(page) %>"><% } else { %><meta name="robots" content="noindex,nofollow"><% } %>
  <meta property="og:site_name" content="z3vok"><meta property="og:locale" content="<%= page.lang === 'zh-CN' ? 'zh_CN' : 'en_US' %>">
  <meta name="twitter:card" content="summary">
  <% if(page.layout==='post') { %><meta name="author" content="z3vok"><meta property="article:published_time" content="<%= page.date.toISOString() %>"><% } %>
  <link rel="icon" href="/assets/emergence.png" type="image/png"><link rel="alternate" type="application/rss+xml" title="z3vok RSS" href="/feed.xml">
  <link rel="stylesheet" href="/css/journal.css"><script>try{document.documentElement.dataset.theme=localStorage.getItem('z3vok-theme')||'light'}catch(e){}</script>
  <script src="/js/journal.js" defer></script>
</head>
<body class="<%= page.layout === 'post' ? 'is-post' : '' %>">
  <a class="skip-link" href="#main">Skip to content</a><div class="reading-progress" aria-hidden="true"></div>
  <header class="site-header"><div class="header-inner">
    <a class="brand" href="/" aria-label="z3vok home"><span>z3vok</span></a>
    <nav aria-label="Main navigation"><a href="/writing/" <%- page.section === 'writing' || page.layout === 'post' ? 'aria-current="page"' : '' %>>Writing</a><a href="/about/" <%- page.section === 'about' ? 'aria-current="page"' : '' %>>About</a></nav>
    <div class="header-actions"><button class="search-trigger" aria-label="Search articles"><svg viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><kbd>⌘ K</kbd></button><button class="theme-toggle" aria-label="Switch to dark mode"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 0 0 16Z" fill="currentColor"/></svg></button></div>
  </div></header>
  <main id="main"><%- body %></main>
  <footer class="site-footer"><span>© z3vok</span><a href="/feed.xml">RSS</a><a href="#" class="back-top">↑ Top</a></footer>
  <dialog id="search-dialog" aria-label="Search articles"><div class="search-bar"><svg viewBox="0 0 24 24" fill="none"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4.5 4.5"/></svg><input type="search" id="global-search" aria-label="Enter a title, technology or keyword" placeholder="Search titles, technologies, keywords…" autocomplete="off"><button class="search-close" aria-label="Close search">ESC</button></div><div id="search-results" aria-live="polite"><p class="search-hint">Search by topic, technology or keyword.</p></div><div class="search-foot">Local search · No tracking</div></dialog>
</body></html>
